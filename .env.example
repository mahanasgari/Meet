# Copy to `.env` and fill in values. Never commit `.env`.
#
# Generate strong LiveKit credentials (secret must be ≥ 32 characters):
#   ./scripts/gen-livekit-credentials.sh

# ── Public hostnames (production) ──────────────────────────────────
# Apex / app hostname (A/AAAA record → VPS).
DOMAIN=meet.example.com
# Email for Let's Encrypt registration (Caddy).
ACME_EMAIL=you@example.com

# ── Next.js ↔ LiveKit (required) ───────────────────────────────────
# URL the *browser* uses to reach LiveKit signaling (WSS behind Caddy).
# Production example:  wss://livekit.meet.example.com
# Local compose test:  ws://localhost:7880
LIVEKIT_URL=wss://livekit.meet.example.com

# Shared with the LiveKit server (set via the same .env). Use unique values
# on any real server — never ship local-only defaults off localhost.
# LiveKit requires the API secret to be at least 32 characters.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── LiveKit RTC (optional) ─────────────────────────────────────────
# Advertise the VPS public IP for WebRTC (recommended on a real server).
LIVEKIT_USE_EXTERNAL_IP=true
# If ICE fails behind 1:1 NAT, set the public IPv4 explicitly:
# LIVEKIT_NODE_IP=203.0.113.10

LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50100
LIVEKIT_LOG_LEVEL=info

# ── Local development only (npm run dev + docker-compose.dev.yml) ──
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=local_dev_only_secret_do_not_use_in_prod
# LIVEKIT_USE_EXTERNAL_IP=false
